+    """Validate on every configured set and log each one SEPARATELY.
+
+    Per-set numbers are the point. A pooled loss over a bilingual valid set cannot
+    distinguish "good at English, broken at Nepali" from "mediocre at both" -- that
+    is exactly how v3 hid a dead Nepali model behind a flat curve for 200k steps.
+    """
+    sets = parse_valid_sets(args.data.valid_jsonl)
+    merged: dict[str, float] = {}
+    for name, path in sets:
+        m = _validate_one(model, mimi, args, device, rank, world_size, path)
+        if rank == 0:
+            shown = {k: f"{v:.4f}" for k, v in m.items()}
+            # keep the historical single-set line format greppable by curve_vs.py
+            tag = "" if len(sets) == 1 else f" [{name}]"
+            logger.info(f"valid{tag} @ step {step}: {shown}")
+        prefix = "" if len(sets) == 1 else f"{name}/"
+        merged.update({f"{prefix}{k}": v for k, v in m.items()})
+    return merged
 
 
