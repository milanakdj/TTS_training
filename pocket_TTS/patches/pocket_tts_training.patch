+def _graft_embedding(flow_state: dict, flow_lm: nn.Module, inherited: int) -> dict:
+    """Resize the pretrained text embedding for a vocabulary that EXTENDS it.
+
+    `conditioner.embed` is nn.Embedding(n_bins + 1, dim) and the LAST row is
+    padding, not a piece -- so growing the vocabulary is not a plain append. The
+    pretrained padding row lives at index `old_n_bins` and has to move to the new
+    last index, or every Nepali piece would be trained against a row that the
+    model already reads as "no text here".
+
+    Rows [0, inherited) keep their pretrained values; rows [inherited, new_n_bins)
+    are the newly grafted pieces and are initialized from the fresh module.
+    """
+    key = "conditioner.embed.weight"
+    old = flow_state.get(key)
+    if old is None:
+        raise KeyError(f"{key} missing from the pretrained state")
+    new = flow_lm.conditioner.embed.weight.data.clone()
+    if old.shape[0] > new.shape[0]:
+        raise ValueError(
+            f"grafting requires the new vocabulary to be larger: {tuple(old.shape)} "
+            f"-> {tuple(new.shape)}"
+        )
+    if inherited > old.shape[0] - 1:
+        raise ValueError(
+            f"graft_text_embedding={inherited} exceeds the {old.shape[0] - 1} "
+            "pretrained pieces (the last row is padding, not a piece)"
+        )
+    new[:inherited] = old[:inherited]
+    new[-1] = old[-1]                      # padding row, moved to the new tail
+    flow_state = dict(flow_state)
+    flow_state[key] = new
+    logger.info(
+        "grafted text embedding %s -> %s: rows 0..%d inherited, %d..%d fresh, "
+        "padding moved %d -> %d",
+        tuple(old.shape), tuple(new.shape), inherited - 1, inherited,
+        new.shape[0] - 2, old.shape[0] - 1, new.shape[0] - 1,
+    )
+    return flow_state
+
