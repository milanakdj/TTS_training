 },
 {
  "id": "034",
  "source": "ans_snr50",
  "speaker": "t7kxzwdrHGA/SPEAKER_02",
  "text": "अब त्यति आउँदैन भने, जे सक्छौ पकाऊ भन्ने।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCCIg2o64yeZNvECqROUbeEA/t7kxzwdrHGA/chunk_375_4.56s.wav",
