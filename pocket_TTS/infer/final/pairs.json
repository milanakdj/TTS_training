  "duration": 4.82,
  "prompt": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UCVFNatZh-fkYj8AS1rLz4VQ/tlhciYSA3EU/chunk_102_4.26s.wav"
 },
