  "prompt": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCczsYSRGukY9LA7Fd_govMw/hH4epVNf3ig/chunk_839_4.50s.wav"
 },
 {
  "id": "039",
  "source": "ans_snr50",
  "speaker": "r5nMpxUucNc/SPEAKER_02",
  "text": "अब संविधानअनुसार प्रतिनिधि सभा नै प्रति नै उनी उत्तरदायी हुनुपर्ने अवस्था छ।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCczsYSRGukY9LA7Fd_govMw/r5nMpxUucNc/chunk_480_7.54s.wav",
  "duration": 7.54,
  "prompt": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCczsYSRGukY9LA7Fd_govMw/r5nMpxUucNc/chunk_562_4.10s.wav"
 },
 {
  "id": "040",
  "source": "ans_snr50",
  "speaker": "Of8OuMwoLDk/SPEAKER_03",
  "text": "केही पर लगी त्यहाँ हालेको पानी चनामा पुग्ने व्यवस्था गरेछ, र भोलि बिहान शिवलिङ्ग प्रकट हुन्छ भनेर आफू ध्यानमा बसी रातमा चेलाहरूलाई पाइपबाट पानी हाल्न लगाएछ।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCjiIDYcI5hfpv_J16SxuHFg/Of8OuMwoLDk/chunk_617_9.70s.wav",
