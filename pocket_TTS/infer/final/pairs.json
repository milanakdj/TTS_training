  "duration": 7.32,
  "prompt": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UCczsYSRGukY9LA7Fd_govMw/nF4oL2c5NTI/chunk_581_4.28s.wav"
 },
 {
  "id": "050",
  "source": "indicvoices-r-long",
  "speaker": "v1/S4258680300317474",
  "text": "काठमाडौँ न्युयोर्क हङकङ टोरेन्टो पेरिस",
