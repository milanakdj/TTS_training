  "prompt": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UCbBfzO3Rc1Uxc8VEnAeHWGg/2fkBA8MIIEY/chunk_321_4.94s.wav"
 },
 {
  "id": "048",
  "source": "ans_snr50",
  "speaker": "aCizmZeQzc4/SPEAKER_00",
  "text": "राष्ट्रियता, लोकतन्त्र, प्रजातन्त्रको निम्ति संविधानको निम्ति लडेर आउनुभयो।",
