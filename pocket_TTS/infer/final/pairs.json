  "prompt": "/workspace/proc_data_new/indicvoices-r/train/audio/Nepali/mdx_extra/v1/train/audios/3940649673961322_chunk_6.wav"
 },
 {
  "id": "070",
  "source": "indicvoices-r",
  "speaker": "audios/S4257713700348239",
  "text": "मातृभाषामा चाहिँ जान्नु मातृभाषाबाट सिक्नु हो यो चाहिँ जरुरी एकदमै जरुरी आवश्यक छ",
