  "duration": 7.071,
  "prompt": "/workspace/proc_data_new/indicvoices-r/train/audio/Nepali/mdx_extra/v1/train/audios/3940649673986914_chunk_1.wav"
 },
 {
  "id": "071",
  "source": "indicvoices-r",
  "speaker": "audios/S4259440200361747",
  "text": "सबैभन्दा मुख्य उद्योगधन्दा चाहिँ टी गार्डन दोस्रोमा छ सिन्कोना प्लान्टेसन",
  "real_audio": "/workspace/proc_data_new/indicvoices-r/train/audio/Nepali/mdx_extra/v1/train/audios/3940649673993380_chunk_2.wav",
