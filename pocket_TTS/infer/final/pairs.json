  "prompt": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UCcCg5DCDaIpgLphMkJbK-wA/aCizmZeQzc4/chunk_454_3.60s.wav"
 },
 {
  "id": "049",
  "source": "ans_snr50",
  "speaker": "nF4oL2c5NTI/SPEAKER_03",
  "text": "भन्दा नेपालको सबै किसिमको कानुन होइन, संविधान सबैमाथि एकपल्ट बस्या मानिस हो नि।",
