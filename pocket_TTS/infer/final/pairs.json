  "prompt": "/workspace/proc_data_new/indicvoices-r/train/audio/Nepali/mdx_extra/v3/train/audios/3940649674017086_chunk_1.wav"
 },
 {
  "id": "081",
  "source": "indicvoices-r",
  "speaker": "audios/S4259662500304765",
  "text": "भाँच्चिए पछि सुन्निने रगत बग्ने र विकृतिले औसत स्नायुलाई सङ्कुचित पार्दछ",
