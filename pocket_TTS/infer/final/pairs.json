  "duration": 7.42,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UCMiQlCEmLQd6JN3cI0yZ1-A/7jdS9Uzom_A/chunk_072_3.14s.wav"
 },
 {
