  "prompt": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UCGlV0eWm10tmyKm0bJ9ms4w/IPQWMk5RqVM/chunk_120_4.60s.wav"
 },
 {
  "id": "023",
  "source": "ans_snr40-50",
  "speaker": "X_9l7u_D86w/SPEAKER_02",
  "text": "अफकोर्स, यस लाग्छ नि। अति गाह्रो भएपछि थाहा छ, जब अति रुइन्छ नि त?",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UCRyTiea063y4QA-YOedu6lQ/X_9l7u_D86w/chunk_1241_6.88s.wav",
  "duration": 6.88,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UCRyTiea063y4QA-YOedu6lQ/X_9l7u_D86w/chunk_545_3.26s.wav"
 },
 {
  "id": "024",
  "source": "ans_snr40-50",
  "speaker": "WuoYzhA5-gs/SPEAKER_02",
  "text": "हजुर, अँ मिलाएर लेख्नुपर्छ। मैले त पोइन्ट लेखिदिएको, यसलाई मिलाएर लेख्नु है।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UClDw4ijXzb9YxiU5nWinEfQ/WuoYzhA5-gs/chunk_256_3.40s.wav",
  "duration": 3.4,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UClDw4ijXzb9YxiU5nWinEfQ/WuoYzhA5-gs/chunk_111_3.58s.wav"
 },
 {
  "id": "025",
  "source": "ans_snr40-50",
  "speaker": "qbsw1VmQ1Ks/SPEAKER_01",
  "text": "र एउटा लास्ट मेटल जुन हाम्रो बाँकी छ, त्यो भनेको चाहिँ गोल्ड हो।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UClDw4ijXzb9YxiU5nWinEfQ/qbsw1VmQ1Ks/chunk_209_4.36s.wav",
  "duration": 4.36,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UClDw4ijXzb9YxiU5nWinEfQ/qbsw1VmQ1Ks/chunk_066_3.36s.wav"
 },
 {
