  "prompt": "/workspace/proc_data_new/indicvoices-r/train/audio/Nepali/mdx_extra/v2/train/audios/3940649674018812_chunk_1.wav"
 },
 {
  "id": "075",
  "source": "indicvoices-r",
  "speaker": "audios/S4259723400369389",
  "text": "हाम्रो दार्जिलिङ जिल्लामा चाहिँ यो रीति रिवाजको चाहिँ के परम्परा छ भने चाहिँ",
