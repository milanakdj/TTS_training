  "prompt": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCCIg2o64yeZNvECqROUbeEA/t7kxzwdrHGA/chunk_217_4.94s.wav"
 },
 {
  "id": "035",
  "source": "ans_snr50",
  "speaker": "6BvliS4pa8w/SPEAKER_02",
  "text": "त्यसबाट मुक्तिको बाटोलाई हामीले प्राप्त गर्नुपर्छ।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCDeNjdARlhMEO-EbfzD6I9Q/6BvliS4pa8w/chunk_055_3.98s.wav",
