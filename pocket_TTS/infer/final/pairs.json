  "prompt": "/workspace/proc_data_new/indicvoices-r/train/audio/Nepali/mdx_extra/v3/train/audios/3940649674006299_chunk_2.wav"
 },
 {
  "id": "080",
  "source": "indicvoices-r",
  "speaker": "audios/S4259043200302793",
  "text": "जियो मनीमा धेरैपटक गलत युपिआई आइडी किन देखाइरहेछ",
  "real_audio": "/workspace/proc_data_new/indicvoices-r/train/audio/Nepali/mdx_extra/v3/train/audios/3940649674017096_chunk_1.wav",
