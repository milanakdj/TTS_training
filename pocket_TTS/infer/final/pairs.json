 },
 {
  "id": "053",
  "source": "indicvoices-r-long",
  "speaker": "v1/S4259871400332330",
  "text": "मलाई सबै थरीका भान्साका सामाग्री देखाउनुहोस्",
  "real_audio": "/workspace/proc_data_new/indicvoices-r-long/train/audios/Nepali/v1/3940649673982973.wav",
