  "duration": 5.76,
  "prompt": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UCPoDCoxg9_DAn5tkhKCxtow/a_qE36xQMRY/chunk_225_3.18s.wav"
 },
 {
  "id": "045",
  "source": "ans_snr50",
  "speaker": "tlhciYSA3EU/SPEAKER_01",
  "text": "अब हामीले त मैले त कमसेकम दुई चार सय नै पटक अनुरोध गरेँ होला।",
