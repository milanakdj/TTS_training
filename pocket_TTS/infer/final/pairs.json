  "prompt": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCjiIDYcI5hfpv_J16SxuHFg/Of8OuMwoLDk/chunk_052_4.44s.wav"
 },
 {
  "id": "041",
  "source": "ans_snr50",
  "speaker": "hHA4ShkIxro/SPEAKER_00",
  "text": "सो जस्तो खालको डाइग्राम दिन्छ। अब यसको ग्राउन्डमा यसले कति पोर्सन टच गऱ्यो, त्यति नै पोर्सनको एरिया निकाल्नु पऱ्यो।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UClDw4ijXzb9YxiU5nWinEfQ/hHA4ShkIxro/chunk_191_7.88s.wav",
  "duration": 7.88,
  "prompt": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UClDw4ijXzb9YxiU5nWinEfQ/hHA4ShkIxro/chunk_527_3.16s.wav"
 },
 {
  "id": "042",
  "source": "ans_snr50",
  "speaker": "ivTMSoU-600/SPEAKER_01",
  "text": "तर मेरो मनमा कौतुहलता जाग्यो, कि यो मान्छे को हो जसको बारेमा काकी सबैबाट लुकाउन चाहनुहुन्छ।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCzd7a1YUa2uaqBBYwLH4eIg/ivTMSoU-600/chunk_026_6.70s.wav",
  "duration": 6.7,
  "prompt": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCzd7a1YUa2uaqBBYwLH4eIg/ivTMSoU-600/chunk_194_4.70s.wav"
 },
 {
  "id": "043",
  "source": "ans_snr50",
  "speaker": "-RnvVm4aiHI/SPEAKER_01",
  "text": "पक्का गर्नुहोस् है भन्नको लागि। मेक स्योर, मेक स्योर।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UCCIg2o64yeZNvECqROUbeEA/-RnvVm4aiHI/chunk_121_6.18s.wav",
