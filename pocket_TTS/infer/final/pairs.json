[
 {
  "id": "000",
  "source": "rasa",
  "speaker": "Nepali/Srijana",
  "text": "मोहन एकछिन छक्क परेर शेखरका मुखमा हेरिरह्यो।",
  "real_audio": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_F_BOOK_01145.wav",
  "duration": 3.789,
  "prompt": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_F_CONV_00347.wav"
 },
 {
  "id": "001",
  "source": "rasa",
  "speaker": "Nepali/Srijana",
  "text": "फुलको गमलाभरि पुरै किराहरू सल्बलाउँदै रहेछ। मलाई त कस्तो घिन लागेको नि!",
  "real_audio": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_F_DISGUST_00421.wav",
  "duration": 6.755,
  "prompt": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_F_CONV_00761.wav"
 },
 {
  "id": "002",
  "source": "rasa",
  "speaker": "Nepali/Srijana",
  "text": "यस गर्मीमा आर्द्रताका साथ पारा बढ्दै जाँदा म चेन्नईको गर्मीबाट थकित अनुभव गर्दछु।",
  "real_audio": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_F_SAD_00206.wav",
  "duration": 7.267,
  "prompt": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_F_CONV_02072.wav"
 },
 {
  "id": "003",
  "source": "rasa",
  "speaker": "Nepali/Srijana",
  "text": "ओहो! मेट्रोमा साइकल चलाउने अनुमति रहेछ नि। मलाई त कहिल्यै थाहा थिएन।",
  "real_audio": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_F_SURPRISE_00339.wav",
  "duration": 6.568,
  "prompt": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_F_CONV_01099.wav"
 },
 {
  "id": "004",
  "source": "rasa",
  "speaker": "Nepali/Sagar",
  "text": "म बाथरुमका सामग्री अर्डर गर्न चाहन्छु, के तपाईँ मलाई त्यस कोटीमा उपलब्ध सबै कुरा देखाउन सक्नुहुन्छ?",
  "real_audio": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_BB_00066.wav",
  "duration": 7.462,
  "prompt": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_BOOK_00184.wav"
 },
 {
  "id": "005",
  "source": "rasa",
  "speaker": "Nepali/Sagar",
  "text": "एउटा स्वस्थ जीवनको पछाडि सफाइ एउटा महत्त्वपूर्ण कारक हो।",
  "real_audio": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_CONV_00566.wav",
  "duration": 4.563,
  "prompt": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_WIKI_02738.wav"
 },
 {
  "id": "006",
  "source": "rasa",
  "speaker": "Nepali/Sagar",
  "text": "म ती सङ्गीतसँगै हुर्केको हुँ, तपाईँलाई थाहा छ।",
  "real_audio": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_CONV_00787.wav",
  "duration": 3.529,
  "prompt": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_BOOK_00220.wav"
 },
 {
  "id": "007",
  "source": "rasa",
  "speaker": "Nepali/Sagar",
  "text": "त्यसकारण बिहान छ पैँतालिस बजी तपाईँ मतदान केन्द्रमा आइपुग्नुहोस्।",
  "real_audio": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_CONV_00867.wav",
  "duration": 4.716,
  "prompt": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_CONV_02098.wav"
 },
 {
  "id": "008",
  "source": "rasa",
  "speaker": "Nepali/Sagar",
  "text": "र त्यसपछि अन्त्यमा आयकर पोर्टलमा एक्सएमएल फाइल अपलोड गर्नुहोस्।",
  "real_audio": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_CONV_01043.wav",
  "duration": 5.541,
  "prompt": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_BOOK_00171.wav"
 },
 {
  "id": "009",
  "source": "rasa",
  "speaker": "Nepali/Sagar",
  "text": "के यो योजना नगदरहित हो, र के कुनै लाभार्थीले कुनै बायोमेट्रिक कार्ड प्राप्त गर्नेछन्?",
  "real_audio": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_CONV_02247.wav",
  "duration": 6.467,
  "prompt": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_BOOK_00106.wav"
 },
 {
  "id": "010",
  "source": "rasa",
  "speaker": "Nepali/Sagar",
  "text": "मैले होटलबाट अर्डर गरेको खानासँग साँच्चै मेरो चित्त बुझ्यो। साह्रै स्वादिलो!",
  "real_audio": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_HAPPY_00139.wav",
  "duration": 5.997,
  "prompt": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_SAD_00166.wav"
 },
 {
  "id": "011",
  "source": "rasa",
  "speaker": "Nepali/Sagar",
  "text": "के तपाईँँ आर्किटेक्चरमा एआइसिटिई स्वीकृत सबै कलेजहरू सूचीबद्ध गर्न सक्नुहुन्छ?",
  "real_audio": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_UMANG_00077.wav",
  "duration": 6.824,
  "prompt": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_WIKI_01003.wav"
 },
 {
  "id": "012",
  "source": "rasa",
  "speaker": "Nepali/Sagar",
  "text": "गोपद सोन नदीको प्रमुख शाखा हो र यसको उत्पत्ति मेन्द्रा गाउँबाट लगभग दस किलोमिटर उत्तरमा भएको छ।",
  "real_audio": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_WIKI_02474.wav",
  "duration": 8.57,
  "prompt": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_WIKI_02324.wav"
 },
 {
  "id": "013",
  "source": "rasa",
  "speaker": "Nepali/Sagar",
  "text": "यहाँ गुन्डोलाव ताल नामको एउटा धरोहर ताल छ।",
  "real_audio": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_WIKI_02831.wav",
  "duration": 3.91,
  "prompt": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_CONV_00053.wav"
 },
 {
  "id": "014",
  "source": "rasa",
  "speaker": "Nepali/Sagar",
  "text": "खटखटेमा कम्तीमा पाँचवटा तरकारी, ताजा नरिवल र विशेष गोआन मसला हुन्छन् जसले सुगन्ध थप्छन्।",
  "real_audio": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_WIKI_02939.wav",
  "duration": 8.419,
  "prompt": "/workspace/proc_data_new/ai4bharat___rasa/train/audio/Nepali/NEP_M_BOOK_00169.wav"
 },
 {
  "id": "015",
  "source": "rasa",
  "speaker": "Nepali/Sagar",
  "text": "जति दिन म संसारमा रहुँला जहाँ गए पनि कुनै अवस्थामा पनि, म तिम्रो स्नेह औ प्रीति बिर्सनेछैनँ।",
  "real_audio": "/workspace/proc_data_new/ai4bharat___rasa/val/audio/Nepali/NEP_M_BOOK_00572.wav",
  "duration": 9.048,
  "prompt": "/workspace/proc_data_new/ai4bharat___rasa/val/audio/Nepali/NEP_M_WIKI_03469.wav"
 },
 {
  "id": "016",
  "source": "ans_snr40-50",
  "speaker": "5Sui3R4uQig/SPEAKER_01",
  "text": "अब यो उहाँले कुन दृष्टिकोणबाट त्यसो कुरा गर्नुभयो? मलाई लाग्छ यो मैले जुन कुरा भनेँ नि, मासिक रूपमा।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UC3yDoaqQzOd1bNP74ZrGPTA/5Sui3R4uQig/chunk_320_7.82s.wav",
  "duration": 7.82,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UC3yDoaqQzOd1bNP74ZrGPTA/5Sui3R4uQig/chunk_428_4.66s.wav"
 },
 {
  "id": "017",
  "source": "ans_snr40-50",
  "speaker": "LJ4qpqpUhXQ/SPEAKER_28",
  "text": "सत्तारूढ गठबन्धन स्थानीय तहको निर्वाचन नै सार्ने उपाय खोजिरहेका बेला, निर्वाचन आयोग भन्छ— मिति छिटो घोषणा गर।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UC3yDoaqQzOd1bNP74ZrGPTA/LJ4qpqpUhXQ/chunk_000_8.62s.wav",
  "duration": 8.62,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UC3yDoaqQzOd1bNP74ZrGPTA/LJ4qpqpUhXQ/chunk_153_3.84s.wav"
 },
 {
  "id": "018",
  "source": "ans_snr40-50",
  "speaker": "Z8HfufeKg8M/SPEAKER_03",
  "text": "ले नेपालमा अलिकति गतिशीलता बढाएका छन्, होइन?",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UC3yDoaqQzOd1bNP74ZrGPTA/Z8HfufeKg8M/chunk_035_4.88s.wav",
  "duration": 4.88,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UC3yDoaqQzOd1bNP74ZrGPTA/Z8HfufeKg8M/chunk_146_3.50s.wav"
 },
 {
  "id": "019",
  "source": "ans_snr40-50",
  "speaker": "lCYs2tKZ4kE/SPEAKER_03",
  "text": "प्याक्टिकल कसरी गर्ने, समय कति दिने भन्दा पनि कसरी गर्नेमा बढी जोड दिनुहुन्थ्यो उहाँले।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UC3yDoaqQzOd1bNP74ZrGPTA/lCYs2tKZ4kE/chunk_160_6.14s.wav",
  "duration": 6.14,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UC3yDoaqQzOd1bNP74ZrGPTA/lCYs2tKZ4kE/chunk_131_4.72s.wav"
 },
 {
  "id": "020",
  "source": "ans_snr40-50",
  "speaker": "gsSA0LceYYs/SPEAKER_00",
  "text": "त्यो व्यक्तिले ताप उत्पन्न गर्नको लागि यहाँ औँठी लगाएको हुन्छ, तर सामान्यतया त्यसरी औँठी लगाएर ताप उत्पन्न गर्नुभन्दा।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UC41lrNBYb9fNWnQHFyuv9wQ/gsSA0LceYYs/chunk_235_9.14s.wav",
  "duration": 9.14,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UC41lrNBYb9fNWnQHFyuv9wQ/gsSA0LceYYs/chunk_197_3.36s.wav"
 },
 {
  "id": "021",
  "source": "ans_snr40-50",
  "speaker": "sFXuv3M63_4/SPEAKER_01",
  "text": "विद्यार्थीहरूलाई डाटा सम्बन्धी ज्ञान नहुनु जस्तै, अहिले हाम्रो एनटिसीले चाहिँ तीन सय पन्ध्र रुपियाँको मासिक डाटा चाहिँ प्रोभाइड गरिरहेको छ।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UC6nOP_RGftKR2uW3cibDkHg/sFXuv3M63_4/chunk_150_6.98s.wav",
  "duration": 6.98,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UC6nOP_RGftKR2uW3cibDkHg/sFXuv3M63_4/chunk_092_4.84s.wav"
 },
 {
  "id": "022",
  "source": "ans_snr40-50",
  "speaker": "IPQWMk5RqVM/SPEAKER_01",
  "text": "यसले समाजमा राम्रो गर्दैन। हेर्नुहोस्, एकजना निर्दोष मान्छेलाई।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UCGlV0eWm10tmyKm0bJ9ms4w/IPQWMk5RqVM/chunk_296_3.56s.wav",
