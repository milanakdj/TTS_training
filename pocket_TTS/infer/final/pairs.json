 },
 {
  "id": "076",
  "source": "indicvoices-r",
  "speaker": "audios/S4259394300375548",
  "text": "बाथरुमको सामग्रीमा सबै भन्दा राम्रो बिक्रीका सिफारिसहरू के हुन्",
