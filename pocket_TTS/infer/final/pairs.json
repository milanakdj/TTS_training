 },
 {
  "id": "033",
  "source": "ans_snr50",
  "speaker": "KNSPN0qleVY/SPEAKER_01",
  "text": "म कुकुरहरूसँग डराउँछु, भन्नलाई आई एम अ फ्रेड अफ डग्स।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCCIg2o64yeZNvECqROUbeEA/KNSPN0qleVY/chunk_055_4.72s.wav",
