 },
 {
  "id": "030",
  "source": "ans_snr40-50",
  "speaker": "AZLdaf0Fv4Y/SPEAKER_01",
  "text": "र त्यो बेलामा भारतले नेपालमाथि नाकाबन्दी लगाएको थियो।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UCczsYSRGukY9LA7Fd_govMw/AZLdaf0Fv4Y/chunk_065_3.30s.wav",
