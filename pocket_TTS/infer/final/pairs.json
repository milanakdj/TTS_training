  "prompt": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCDeNjdARlhMEO-EbfzD6I9Q/6BvliS4pa8w/chunk_022_3.06s.wav"
 },
 {
  "id": "036",
  "source": "ans_snr50",
  "speaker": "61Lev_nBWVE/SPEAKER_02",
  "text": "ज्याक माले आफ्नो फर्स्ट रिसेप्सनिस्टलाई चाहिँ हायर गरेको थियो, उसको नाम चाहिँ टम के थियो। आई डोन्ट नो, मैले अहिले एक्ज्याक्ट मोमेन्टमा मलाई चाहिँ याद भएन।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCEPwYtQk8TZl5kJD9Bq4kcA/61Lev_nBWVE/chunk_227_8.92s.wav",
  "duration": 8.92,
  "prompt": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCEPwYtQk8TZl5kJD9Bq4kcA/61Lev_nBWVE/chunk_218_4.06s.wav"
 },
 {
  "id": "037",
  "source": "ans_snr50",
  "speaker": "JgPTiqrfBJ0/SPEAKER_03",
  "text": "यस्तरी बोल्नु सुहाउँदैन भन्छ। मेरो चाहिँ स्पष्टीकरण के छ भने, म ठुलो मान्छे हुँदै होइन, पहिलो कुरा।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCczsYSRGukY9LA7Fd_govMw/JgPTiqrfBJ0/chunk_179_7.06s.wav",
  "duration": 7.06,
  "prompt": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCczsYSRGukY9LA7Fd_govMw/JgPTiqrfBJ0/chunk_525_4.54s.wav"
 },
 {
  "id": "038",
  "source": "ans_snr50",
  "speaker": "hH4epVNf3ig/SPEAKER_03",
  "text": "हामीले जुन खालको एउटा गठबन्धन तयार गरेर अगाडिको यात्रा हामीले चाहिँ बनाएका थियौँ।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCczsYSRGukY9LA7Fd_govMw/hH4epVNf3ig/chunk_549_8.02s.wav",
