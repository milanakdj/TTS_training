[
 {
  "id": "c000",
  "source": "ans_snr40-50",
  "text": "कौसी खेतीको तालिम, जुत्ता बनाउने तालिम।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UC1p86Eqax3IrYqJ3akGyFEQ/rMs-KgsNT_I/chunk_132_3.14s.wav",
  "duration": 3.14,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UC1p86Eqax3IrYqJ3akGyFEQ/rMs-KgsNT_I/chunk_274_3.18s.wav"
 },
 {
  "id": "c001",
  "source": "ans_snr40-50",
  "text": "देश निर्माणको एउटा महत्त्वपूर्ण विषयवस्तु पनि लुकेको छ।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UCDeNjdARlhMEO-EbfzD6I9Q/AKrAfZcS36g/chunk_107_5.06s.wav",
  "duration": 5.06,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UCDeNjdARlhMEO-EbfzD6I9Q/AKrAfZcS36g/chunk_094_4.26s.wav"
 },
 {
  "id": "c002",
  "source": "ans_snr40-50",
  "text": "धेरै सहज अनुभूति गर्नुभएको छ, विद्यार्थीहरूले अब अध्यक्ष हो, अब विद्यालय चाहिँ अब कहिले खुल्छ?",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UCHFquACtX0Vwu4lHbtgQo2A/uiv-txdlg7o/chunk_104_7.90s.wav",
  "duration": 7.9,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UCHFquACtX0Vwu4lHbtgQo2A/uiv-txdlg7o/chunk_188_3.62s.wav"
 },
 {
  "id": "c003",
  "source": "ans_snr40-50",
  "text": "किनभने अब एआई आइसकेपछि, चरित्रहरू एआईले निर्माण गरिदिन लागिसक्यो।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UCcCg5DCDaIpgLphMkJbK-wA/Iss2s6QnI2M/chunk_536_4.44s.wav",
  "duration": 4.44,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UCcCg5DCDaIpgLphMkJbK-wA/Iss2s6QnI2M/chunk_138_3.66s.wav"
 },
 {
  "id": "c004",
  "source": "ans_snr40-50",
  "text": "अनि यो गठबन्धनको सरकार कि गठबन्धनभित्र एउटा टुट्नु पऱ्यो, गठबन्धन छोड्नु पऱ्यो।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UCczsYSRGukY9LA7Fd_govMw/hH4epVNf3ig/chunk_735_4.84s.wav",
  "duration": 4.84,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UCczsYSRGukY9LA7Fd_govMw/hH4epVNf3ig/chunk_655_3.68s.wav"
 },
 {
  "id": "c005",
  "source": "ans_snr40-50",
  "text": "रिस्टोर भनेको चाहिँ रिसाइकल गर्नु हो वा फेरि पुरानो ठाउँमा लगेर राख्नु हो? डिलिट भनेको चाहिँ कम्प्युटरबाट चाहिँ पर्मानेन्टली फालिदिनु हो।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UClDw4ijXzb9YxiU5nWinEfQ/eNf8uhh-xfc/chunk_065_9.58s.wav",
  "duration": 9.58,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UClDw4ijXzb9YxiU5nWinEfQ/eNf8uhh-xfc/chunk_202_3.98s.wav"
 },
 {
  "id": "c006",
  "source": "ans_snr40-50",
  "text": "हो तपाईँले भनेको कुरा चाहिँ फेरि स्वतन्त्रताको कुरासँग म जोड्न चाहन्छु।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UCtjmWttibtOsdow5lYBD-7A/SeH3cAI0mp0/chunk_242_4.30s.wav",
  "duration": 4.3,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part1of2/train/audio/automated_new_set/UCtjmWttibtOsdow5lYBD-7A/SeH3cAI0mp0/chunk_321_3.70s.wav"
 },
 {
  "id": "c007",
  "source": "ans_snr40-50",
  "text": "त्यसपछि राम्रो भयो भने, मभन्दा राम्रो फिडब्याक कसैले दिँदैन होला।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UCD9n4NGbZJNoj3eMN8pL27A/cvd0FUJxEI8/chunk_412_4.24s.wav",
  "duration": 4.24,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UCD9n4NGbZJNoj3eMN8pL27A/cvd0FUJxEI8/chunk_335_3.18s.wav"
 },
 {
  "id": "c008",
  "source": "ans_snr40-50",
  "text": "त्यसका विभिन्न केही।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UCDeNjdARlhMEO-EbfzD6I9Q/PgxOU3axPrM/chunk_032_3.86s.wav",
  "duration": 3.86,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UCDeNjdARlhMEO-EbfzD6I9Q/PgxOU3axPrM/chunk_053_4.90s.wav"
 },
 {
  "id": "c009",
  "source": "ans_snr40-50",
  "text": "उहाँले सशक्त आवाज उठाउनु भएको छ, त्यही भएर जुम्ला जस्तो ठाउँमा कहिले पनि राप्रपा आउँदैन थियो।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UCR0sb6TDx2vY0DGsLlDr5BA/J5cuQx0mvvU/chunk_1094_5.30s.wav",
  "duration": 5.3,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UCR0sb6TDx2vY0DGsLlDr5BA/J5cuQx0mvvU/chunk_1307_3.96s.wav"
 },
 {
  "id": "c010",
  "source": "ans_snr40-50",
  "text": "कतिको जान्नु हुँदो रहेछ रेक्टेङ्गलको? है, स्क्वायरको होइन फेरि।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UC_hh-Qb15-_bnpxNo2tMXdQ/BLeQ-3ryMPU/chunk_249_3.92s.wav",
  "duration": 3.92,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UC_hh-Qb15-_bnpxNo2tMXdQ/BLeQ-3ryMPU/chunk_265_4.72s.wav"
 },
 {
  "id": "c011",
  "source": "ans_snr40-50",
  "text": "या उपसभामुख या भनौँ राष्ट्रिय सभाका अध्यक्ष उहाँ चाहिँ नियुक्ति गर्ने अथोरिटी हो त? संसदका मान्छेले।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UCczsYSRGukY9LA7Fd_govMw/BmSYpzTiles/chunk_124_8.34s.wav",
  "duration": 8.34,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UCczsYSRGukY9LA7Fd_govMw/BmSYpzTiles/chunk_164_3.08s.wav"
 },
 {
  "id": "c012",
  "source": "ans_snr40-50",
  "text": "भोल्युम अफ क्युबिकल ट्याङ्क, भी भनेको दिएको छ वान मिटर क्युब। सो भोल्युम अफ क्युबको फर्मुला के हुन्छ? एलक्युब हुन्छ होइन।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UClDw4ijXzb9YxiU5nWinEfQ/MAjKXps-Tqg/chunk_401_7.78s.wav",
  "duration": 7.78,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UClDw4ijXzb9YxiU5nWinEfQ/MAjKXps-Tqg/chunk_325_4.82s.wav"
 },
 {
  "id": "c013",
  "source": "ans_snr40-50",
  "text": "एक्जाम्पलको लागि चाहिँ हाम्रो आउटकम्स हुन्छ नि, अथवा इभेन्ट्सहरू हुन्छ नि? जुन चाहिँ चाहिँ हुनसक्ने सम्भावना छ र, अर्को हाम्रो के हुन सकिन्छ त्यो भनेको चाहिँ हाम्रो।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UClDw4ijXzb9YxiU5nWinEfQ/PQfmxOC2y78/chunk_206_8.84s.wav",
  "duration": 8.84,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UClDw4ijXzb9YxiU5nWinEfQ/PQfmxOC2y78/chunk_427_3.24s.wav"
 },
 {
  "id": "c014",
  "source": "ans_snr40-50",
  "text": "र उहाँको अहिले काठमाडौँ क्षेत्राधिकार काठमाडौँ भएकोले, काठमाडौँ जिल्ला अदालतमा पेस गर्ने हो।",
  "real_audio": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UCo_hCisNRWC3pmRuuEqfP9A/zINP1PCn0_U/chunk_280_4.88s.wav",
  "duration": 4.88,
  "prompt": "/workspace/proc_data_new/ans_snr40-50.part2of2/train/audio/automated_new_set/UCo_hCisNRWC3pmRuuEqfP9A/zINP1PCn0_U/chunk_094_4.66s.wav"
 },
 {
  "id": "c015",
  "source": "ans_snr50",
  "text": "तपाईँको लाइन उहाँले कभर गर्न सकोस् किनकि तपाईँको छोरा तपाईँको छोरी।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCHOPfLieuDXKnglkimB4PWQ/6rzx8iEC4Xk/chunk_219_4.48s.wav",
  "duration": 4.48,
  "prompt": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCHOPfLieuDXKnglkimB4PWQ/6rzx8iEC4Xk/chunk_043_3.22s.wav"
 },
 {
  "id": "c016",
  "source": "ans_snr50",
  "text": "यस्तो क्लासहरू लिएर आउँछौँ, त्यही भएर चाँडोभन्दा चाँडो सबैजनाले फलो गर्नुहोस्। चाँडोभन्दा चाँडो सबैजनाले फलो गर्नुहोस्, लाइक गर्नुहोस्। नेपाल अनलाइन स्कुललाई लाइक गर्नुहोस्, फलो गर्नुहोस्, सेयर गर्नुहोस्।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UClDw4ijXzb9YxiU5nWinEfQ/JtmqG8tJjgE/chunk_816_9.96s.wav",
  "duration": 9.96,
  "prompt": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UClDw4ijXzb9YxiU5nWinEfQ/JtmqG8tJjgE/chunk_061_4.78s.wav"
 },
 {
  "id": "c017",
  "source": "ans_snr50",
  "text": "यदि तपाईँले मेरो कुरा बुझ्नु भएन भने, त्यहाँ जुनसुकै पोर्नोग्राफी चलिरहेको होस्।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCrIciMUtTkmFtOj70fCjHUw/2g4km9o3dPU/chunk_067_4.34s.wav",
  "duration": 4.34,
  "prompt": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCrIciMUtTkmFtOj70fCjHUw/2g4km9o3dPU/chunk_014_4.84s.wav"
 },
 {
  "id": "c018",
  "source": "ans_snr50",
  "text": "पहिलेको पुस्तामा, जब हामी स्कुल कलेजमा थियौँ, तब विश्वविद्यालयहरूमा यस्तो भनाइ प्रचलित थियो विद्यार्थी हुँदा सबै कम्युनिस्ट भन्छन्।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCrIciMUtTkmFtOj70fCjHUw/O6lOlbO91DI/chunk_027_9.20s.wav",
  "duration": 9.2,
  "prompt": "/workspace/proc_data_new/ans_snr50.part1of2/train/audio/automated_new_set/UCrIciMUtTkmFtOj70fCjHUw/O6lOlbO91DI/chunk_014_4.50s.wav"
 },
 {
  "id": "c019",
  "source": "ans_snr50",
  "text": "अहिलेको चाहिँ तपाईँको यो निर्वाचनको पद्धति, निर्वाचनको चरित्र विशेषता।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UC80wr0AmplmwL8P-ECC9TxA/RVB5RiM_9P4/chunk_262_4.28s.wav",
  "duration": 4.28,
  "prompt": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UC80wr0AmplmwL8P-ECC9TxA/RVB5RiM_9P4/chunk_361_3.30s.wav"
 },
 {
  "id": "c020",
  "source": "ans_snr50",
  "text": "त्यसो हो भने तिम्रो तेरो अथवा तपाईँको भन्न चाहिँ के त? योर अथवा योर्स।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UCCIg2o64yeZNvECqROUbeEA/2I6CBqgDzmc/chunk_143_7.72s.wav",
  "duration": 7.72,
  "prompt": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UCCIg2o64yeZNvECqROUbeEA/2I6CBqgDzmc/chunk_261_4.36s.wav"
 },
 {
  "id": "c021",
  "source": "ans_snr50",
  "text": "अर्को प्रश्न अब तपाईँ कतिको राम्रोसँग गाउन सक्नुहुन्छ?",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UCCIg2o64yeZNvECqROUbeEA/MGY93KVL57Y/chunk_264_4.94s.wav",
  "duration": 4.94,
  "prompt": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UCCIg2o64yeZNvECqROUbeEA/MGY93KVL57Y/chunk_235_4.04s.wav"
 },
 {
  "id": "c022",
  "source": "ans_snr50",
  "text": "त्यो त्यो चाहिँ तिर्नै पर्छ, जब आम जनताले आठ घन्टा पाएको छ भने उद्योगले नौ घन्टा पनि पाएको छ भने तिर्नु पर्छ। त यसको मतलब त कानुन रहेन नि त?",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UCFlPB2adH_uHaJfUCODTdrQ/sc-n6eExrDE/chunk_072_9.28s.wav",
  "duration": 9.28,
  "prompt": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UCFlPB2adH_uHaJfUCODTdrQ/sc-n6eExrDE/chunk_231_3.96s.wav"
 },
 {
  "id": "c023",
  "source": "ans_snr50",
  "text": "मैले त संसदमा कुरा पनि उठाएँ, कि त पूर्व मन्त्रीलाई कारवाही गर्नु पर्यो।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UCNSPYrl_sdPfOIS4e1HjhMg/DjdN8yyJUn8/chunk_066_4.10s.wav",
  "duration": 4.1,
  "prompt": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UCNSPYrl_sdPfOIS4e1HjhMg/DjdN8yyJUn8/chunk_094_3.56s.wav"
 },
 {
  "id": "c024",
  "source": "ans_snr50",
  "text": "अनि मुक्तकमा चाहिँ अलिक फरक छ। मुक्तकको वाचन चाहिँ कस्तो हुन्छ भने चार हरफमध्ये पहिलो हरफ र दोस्रो हरफ एकचोटि लगातार वाचन गरिन्छ।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UCaLEoN0-Mxgk3B45uYDSvkg/FrpnUOODpe4/chunk_570_9.20s.wav",
  "duration": 9.2,
  "prompt": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UCaLEoN0-Mxgk3B45uYDSvkg/FrpnUOODpe4/chunk_463_3.32s.wav"
 },
 {
  "id": "c025",
  "source": "ans_snr50",
  "text": "ल, ल एउटा गराइदिन्छु अनि यस्तो खालको सबै तिमी गर्न सक्छौ।",
  "real_audio": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UClDw4ijXzb9YxiU5nWinEfQ/q6fUJ9sGwh8/chunk_098_3.98s.wav",
  "duration": 3.98,
  "prompt": "/workspace/proc_data_new/ans_snr50.part2of2/train/audio/automated_new_set/UClDw4ijXzb9YxiU5nWinEfQ/q6fUJ9sGwh8/chunk_606_4.72s.wav"
 },
 {
  "id": "c026",
  "source": "indicvoices-r-long",
  "text": "अमृत मोजेस पुकार प्रणय विशाल",
  "real_audio": "/workspace/proc_data_new/indicvoices-r-long/train/audios/Nepali/v2/3940649674017863.wav",
  "duration": 5.687,
  "prompt": "/workspace/proc_data_new/indicvoices-r-long/train/audios/Nepali/v2/3940649674017831.wav"
 },
 {
  "id": "c027",
  "source": "indicvoices-r-long",
  "text": "हिजो डेलिभर गरिएका दुध सामग्री म्याद सकिएका थिए",
