# Python
__pycache__/
*.pyc
.venv/
venv/

# Logs
*.log

# Synthetic data pipeline: generated audio and data artifacts (not source-controlled)
synthetic_pipeline/audio_out/
synthetic_pipeline/manifests/
synthetic_pipeline/pids/
synthetic_pipeline/vc_service/seed-vc/
synthetic_pipeline/**/*.wav
synthetic_pipeline/**/run_log.txt

# secrets
.env
synthetic_pipeline/.env

# editor/backup leftovers
*.bak
*.prev
*.pregate
*.pid

# pocket_TTS: 37 GB of it is an upstream checkout (repo/, has its own .git),
# manifests (19 G), checkpoints (11 G) and generated audio. Our own source,
# configs and docs are tracked; our training configs are copied out of the
# ignored checkout into pocket_TTS/configs/ so they survive.
pocket_TTS/repo/
pocket_TTS/manifests/
pocket_TTS/runs/
pocket_TTS/infer/out/
pocket_TTS/infer/bench/
pocket_TTS/infer/emo/
pocket_TTS/infer/ceiling/
pocket_TTS/infer/refs_scored/
pocket_TTS/infer/final/wav/
pocket_TTS/infer/final/listen/
pocket_TTS/**/*.wav
pocket_TTS/**/*.safetensors

# packaged datasets belong on the Hub, not in git
synthetic_pipeline/dataset_nepali_neutral_20h/*.parquet
synthetic_pipeline/dataset_nepali_neutral_20h/metadata.csv

# timestamped editor backups (server.py.bak.1788573899)
*.bak.*

# release/: model-release tooling. The staged_* dirs are byte-identical copies of
# what is already on the Hub, id_map.jsonl maps the archive's hashed ids back to
# original YouTube paths (the most provenance-sensitive file here), and the upload
# log is 17 MB of progress bars. Only the scripts and templates are tracked.
release/staged/
release/staged_brief/
release/staged_teacher/
release/staged_parler/
release/id_map.jsonl
release/*.log
release/_shards/
